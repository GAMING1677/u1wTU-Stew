  flavorText: "\u606F\u3092\u8352\u3052\u3088"
  postComments:
  - "\u3053\u306E\u4EBA\u306E\u614B\u5EA6\u898B\u3066\u308B\u3068\u3001\u708E\u4E0A\u3057\u3066\u5F53\u7136\u3063\u3066\u611F\u3058"
  - "\u708E\u4E0A\u3057\u3066\u308B\u306E\u306B\u6C88\u9ED9\uFF1F\u9003\u3052\u3066\u308B\u3060\u3051\u3058\u3083\u3093"
  - "\u3053\u3093\u306A\u306B\u53E9\u304B\u308C\u3066\u308B\u306E\u306B\u8B1D\u7F6A\u3057\u306A\u3044\u3068\u304B\u56F3\u592A\u904E\u304E\u306A\u3044!?"
  - "\u3053\u3044\u3064\u306E\u6614\u306E\u767A\u8A00\u30E4\u30D0\u304B\u3063\u305F\u304B\u3089\u4ECA\u304B\u3089\u6652\u3057\u307E\u3059"
  - "\u64C1\u8B77\u3057\u3066\u308B\u4EBA\u307E\u3060\u3044\u308B\u306E\uFF1F\u3055\u3059\u304C\u306B\u7121\u7406\u3067\u3057\u3087"
  - "\u89AA\u306E\u9854\u304C\u898B\u3066\u307F\u305F\u3044\u3068\u601D\u3063\u305F\u3089\u3001\u89AA\u3082\u30AF\u30BA\u3059\u304E\u305F"
  - "\u4F8B\u306E\u7D42\u308F\u3063\u3066\u308B\u8B1D\u7F6A\u6587\u3001\u6DFB\u524A\u3057\u3066\u3084\u3063\u305F\u308F"
