  flavorText: "\u30BE\u30F3\u30D3\u306A\u3093\u3066\u306A\u3093\u307C\u3042\u3063\u3066\u3082\u826F\u3044\u3067\u3059\u304B\u3089\u306D"
  postComments:
  - "\u30BF\u30A4\u30E0\u30E9\u30A4\u30F3\u306A\u3093\u3066\u6614\u304B\u3089\u30AB\u30AA\u30B9\u3067\u3057\u3087"
  - "\u30A4\u30F3\u30D7\u30EC\u30BE\u30F3\u30D3\u306B\u305D\u3053\u307E\u3067\u6012\u308B\u7406\u7531\u304C\u308F\u304B\u3089\u306A\u3044\u3002"
  - "\u30BE\u30F3\u30D3\u3068\u5E83\u544A\u3068\u4F55\u304C\u9055\u3046\u306E\uFF1F"
  - "\u300C\u30A4\u30F3\u30D7\u30EC\u30BE\u30F3\u30D3\u6700\u4F4E\uFF01\u300D\u3063\u3066\u8A00\u3063\u3066\u308B\u4EBA\u3082\u7D50\u5C40\u30D0\u30BA\u308A\u305F\u3044\u3060\u3051"
  - "\u5225\u306B\u72AF\u7F6A\u3058\u3083\u306A\u3044\u3057\u30A4\u30F3\u30D7\u30EC\u30BE\u30F3\u30D3\u304F\u3089\u3044\u3067\u76EE\u304F\u3058\u3089\u7ACB\u3066\u3093\u306A"
  - "\u6570\u5B57\u53D6\u308A\u306B\u3044\u304F\u6226\u7565\u3068\u3057\u3066\u306F\u5408\u7406\u7684\u3058\u3083\u306A\u3044\uFF1F"
  - "SNS\u306A\u3093\u3066\u4F7F\u3063\u305F\u3082\u3093\u52DD\u3061\u3067\u3057\u3087"
  - "\u7121\u6599\u30B5\u30FC\u30D3\u30B9\u306B\u7406\u60F3\u90F7\u6C42\u3081\u3066\u3066\u8349"
  - "\u30BE\u30F3\u30D3\u3054\u3068\u304D\u3067\u30AB\u30EA\u30AB\u30EA\u3059\u308B\u6687\u4EBA\u306E\u307F\u306A\u3055\uFF5E\u3093\uFF57\uFF57\uFF57"
