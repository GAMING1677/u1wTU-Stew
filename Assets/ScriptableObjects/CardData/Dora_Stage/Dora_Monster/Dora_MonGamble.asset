  postComments:
  - "\u30A2\u30F3\u30C1\u306E\u7686\u69D8\u306E\u304A\u9670\u3067\u5927\u91CF\u306B\u30A4\u30F3\u30D7\u7A3C\u3052\u305F\u308Fwww"
  - "\u4ECA\u56DE\u306E\u708E\u4E0A\u3067\u4E00\u756A\u5F97\u3057\u305F\u306E\u79C1"
  - "\u898B\u77E5\u3089\u306C\u4ED6\u4EBA\u306B\u4F55\u3092\u8A00\u308F\u308C\u3066\u3082\u4F55\u3082\u611F\u3058\u307E\u305B\u3093\u3051\u3069\uFF1F"
  - "\u541B\u305F\u3061\u306E\u6279\u5224\u30B3\u30E1\u30F3\u30C8\u306E\u304A\u9670\u3067\u53CE\u76CA\u7206\u4F38\u3073\u3067\u3059"
  - "\u6687\u4EBA\u717D\u3063\u3066\u30A4\u30F3\u30D7\u7A3C\u3050\u306E\u304C\u4E00\u756A\u697D\u3060\u308F"
  - "\u30B5\u30EB\u5171\u304C\u559A\u3044\u3066\u3066\u30A6\u30B1\u308B\u3002\u65E5\u672C\u8A9E\u3067\u304A\u9858\u3044\u3057\u307E\u30FC\u3059\uFF01"
