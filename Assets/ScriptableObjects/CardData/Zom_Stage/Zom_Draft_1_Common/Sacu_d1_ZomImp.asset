  cardImage: {fileID: -1482574715470509984, guid: e47b25ad0a64b1f4a836fd340e38018c, type: 3}
  description: "\u30D5\u30A9\u30ED\u30EF\u30FC\xD780\uFF05\u30A4\u30F3\u30D7\u3092\u5F97\u308B\n\u611F\u67D3\u7387+15%"
  cardTag: 
  flavorText: "\u5F15\u7528\u3067\u3059\u3051\u3069\u6587\u53E5\u3042\u308B\u306E\uFF1F"
  postComments:
  - "\u9759\u304B\u3060\u3068\u601D\u3063\u3066\u305F\u30892\u4EBA\u3067\u5869\u898B\u3066\u305F"
  - "\u3068\u3093\u3067\u3082\u306A\u3044\u4E09\u6BDB\u732B\u3044\u305F\u304B\u3089\u898B\u3066"
  - "\u30A4\u30B9\u306B\u843D\u3061\u3066\u3054\u306F\u3093\u98DF\u3079\u3066\u305F\u30CF\u30E0\u30B9\u30BF\u30FC\u898B\u3066"
  - "\u30BB\u30EA\u30A2\u3067\u58F2\u3063\u3066\u308B\u30DF\u30EB\u30AF\u30B9\u30E9\u30A4\u30E0\u3082\u624B\u306B\u3079\u305F\u3064\u304D\u304C\u6B8B\u3089\u306A\u304F\u3066\u697D\u3057\u3044\u3088\uFF01"
  - "\u696D\u52D9\u7528\u62B9\u8336\u30C1\u30E7\u30B3\u958B\u3051\u305F\u3093\u3060\u3051\u3069\u610F\u5473\u304C\u5206\u304B\u3089\u306A\u3044"
  - "\u3053\u308C\u3092\u6B8B\u3059\u610F\u5473\u3082\u4FDD\u6E29\u306B\u3057\u305F\u307E\u307E\u306B\u3057\u3066\u3044\u308B\u610F\u5473\u3082\u5206\u304B\u3089\u306A\u3044"
  - "\u304A\u98A8\u5442\u5927\u4F53\u3053\u308C"
  - "42\u2103\u306E\u30B7\u30E3\u30EF\u4E00\u3092\u9589\u3058\u305F\u76EE\u306B\u5F53\u3066\u308B\u3053\u3068\u3067\u3001\u8996\u529B\u304C\u6025\u901F\u306B\u56DE\u5FA9\u3057\u3001\u30B7\u30E7\u30DC\u30B7\u30E7\u30DC\u3057\u305F\u611F\u3058\u304C\u5927\u5E45\u306B\u6539\u5584\u3055\u308C\u308B\u3068\u3044\u3046"
  - "\u73FE\u5B58\u3059\u308B\u4E2D\u3067\u306F\u4E16\u754C\u6700\u53E4\u306E\u30A8\u30B9\u30AB\u30EC\u30FC\u30BF\u30FC(1902\u5E74\u88FD)\u3068\u306E\u3053\u3068\u3002\u3044\u307E\u3067\u306B\u73FE\u5F79"
  - "\u4ED6\u30AF\u30E9\u30B9\u306E\u6587\u5316\u796D\u306E\u51FA\u3057\u7269\"\u304C3\u6708\u9593\u78E8\u304D\u7D9A\u3051\u305F\u6559\u5BA4\u306E\u5E8A\"\u306E\u5C55\u793A\u3067\u672C\u5F53\u306B\u3001\u7406\u89E3\u304C\u8FFD\u3044\u4ED8\u304B\u306A\u304B\u3063\u305F"
  - "\u300E30\u5206\u306E\u30B5\u4E00\u30D3\u30B9\u6B8B\u696D\u304C\u8A31\u3055\u308C\u3066\u30011\u5206\u306E\u9045\u523B\u304C\u8A31\u3055\u308C\u306A\u3044\u306E\u306F\u3069\u3046\u3057\u3066\u3082\u7D0D\u5F97\u3067\u304D\u307E\u305B\u3093\uFF01\uFF01\u300F"
  - "\u591C\u4E2D\u306B\u828B\u3092\u76D7\u307F\u98DF\u3044\u3057\u3066\u305F\u72AF\u4EBA\u898B\u3066"
  - "\u30A2\u30F3\u30D1\u30F3\u30DE\u30F3\u53F7\u306E\u88C5\u7532\u539A\u6E2C\u3063\u305F\u308980mm\u3042\u3063\u305F\u3001\u30B8\u30E3\u30E0\u304A\u3058\u3055\u3093\u306F\u4F55\u3092\u60F3\u5B9A\u3057\u3066\u3053\u3093\u306A\u91CD\u88C5\u7532\u3092\u30FB\u30FB\u30FB"
