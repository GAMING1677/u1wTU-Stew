  - "\u4ECA\u65E5\u3082\u4E00\u65E5\u304A\u75B2\u308C\u3055\u307E\u3067\u3059\uFF01\u307F\u3093\u306A\u306F\u3069\u3046\u601D\u3046\uFF1F"
  - "\u60C5\u5831\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\u52A9\u304B\u308A\u307E\u3057\u305F\uFF01"
  - "\u672C\u5F53\u306B\u305D\u3046\u601D\u3044\u307E\u3059\u3002\u3082\u3063\u3068\u591A\u304F\u306E\u4EBA\u306B\u5C4A\u3044\u3066\u307B\u3057\u3044"
